# ==============================================================================
# TRUSTPAY AI - Environment Configuration Template (.env.example)
# Copy this file to .env and configure with your credentials.
# NEVER commit your actual .env file with secrets to public version control!
# ==============================================================================

# Application Environment ('sandbox', 'development', or 'production')
ENVIRONMENT=sandbox
DEBUG=false

# Cryptographic Master Secret for HMAC-SHA256 Mandates & Hash Chaining
# In production, generate a secure random 64-character hex string:
# python -c "import secrets; print(secrets.token_hex(32))"
TRUSTPAY_MASTER_SECRET=tp_sec_2026_trustpay_autonomous_fintech_guardrail_hmac_master_key

# Database Connection URL
# For Local SQLite:
DATABASE_URL=sqlite+aiosqlite:///./trustpay.db
# For Managed PostgreSQL (Render, Neon, Supabase, AWS RDS):
# DATABASE_URL=postgresql+asyncpg://trustpay_user:your_password@ep-host.region.render.com:5432/trustpay_db

# Google Gemini API Key (Procurement Agent intent understanding & adversarial injection analysis)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Official PayPal Sandbox REST v2 Credentials
# Obtain from: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_MODE=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_optional_webhook_id

# Deterministic Guardrail Threshold Defaults
DEFAULT_SINGLE_TRANSACTION_LIMIT=40.00
DEFAULT_DAILY_SPEND_LIMIT=100.00
DEFAULT_MONTHLY_SPEND_LIMIT=1000.00
MANDATE_EXPIRATION_MINUTES=30

# CORS Allowed Origins (Comma-separated URLs for your frontend deployments)
# Include your Vercel URL and local development hosts:
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://trustpay-ai.vercel.app

# Frontend Environment Variables (for frontend/.env or Vercel dashboard)
# VITE_API_URL=https://trustpay-backend.onrender.com
# VITE_WS_URL=wss://trustpay-backend.onrender.com/api/ws/activity
