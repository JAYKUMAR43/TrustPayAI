# Frontend Environment Variables Template
# When deploying to Vercel, set these in Project Settings -> Environment Variables.

# Leave empty for local Vite dev (proxied via vite.config.js to http://127.0.0.1:8000)
# In production, set to your deployed backend URL:
VITE_API_URL=https://trustpayai.onrender.com

# WebSocket URL for real-time audit & transaction event feed:
VITE_WS_URL=wss://trustpayai.onrender.com/api/ws/activity
